{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/refresh",
      "schedule": "0 5 * * 1"
    }
  ],
  "functions": {
    "api/cron.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, noimageindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/facebook-connect",
      "destination": "/api/connect?step=facebook-connect"
    },
    {
      "source": "/api/google-connect",
      "destination": "/api/connect?step=google-connect"
    },
    {
      "source": "/api/instagram-connect",
      "destination": "/api/connect?step=instagram-connect"
    },
    {
      "source": "/api/linkedin-connect",
      "destination": "/api/connect?step=linkedin-connect"
    }
  ]
}
