{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron", "schedule": "30 4 * * *" },
    { "path": "/api/refresh", "schedule": "0 5 * * 1" }
  ],
  "functions": {
    "api/cron.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" }]
    }
  ]
}
