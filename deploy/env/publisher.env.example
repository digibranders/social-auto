# /etc/social-auto/publisher.env  (owner root, group social, mode 640). Names only: fill the values on the server.
CHANNEL_KEY=
EDIT_SECRET=
STATUS_SECRET=
CRON_SECRET=
INVITE_SECRET=
ALERT_NTFY_TOPIC=
PUBLIC_ORIGIN=https://social.digibranders.com/publisher
DASHBOARD_ORIGIN=https://social.digibranders.com
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Set to facebook to connect Instagram through Facebook login (Meta's Unified Login, needed by newer Meta apps). The tokens then never expire,
# INSTAGRAM_TOKEN must be a system-user token, and FACEBOOK_APP_ID / FACEBOOK_APP_SECRET are used instead of the INSTAGRAM_APP_* pair. Leave empty for Instagram's own login.
INSTAGRAM_LOGIN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Company pages: the second LinkedIn app. Needed only while LINKEDIN_PAGES=on (set it in dashboard.env as well).
# LINKEDIN_PAGES=on
# LINKEDIN_PAGES_CLIENT_ID=
# LINKEDIN_PAGES_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON list of the products allowed to call the product API (see docs/product-api.md)
PRODUCTS=

# TESTING ONLY: PRODUCT_LIMITS=off lifts the limits a product's customers are held to (batches a day and month, asks for pictures, the weekly pictures of a channel, redraws,
# the one topic and one carousel a week, new topics of a dropped post). Set the SAME value in publisher.env, review.env and engine.env, then restart social-publisher,
# social-review and social-jobs. It does not lift the monthly picture ceiling of a brand or the spending limits of the paid-call ledger. Remove the line to put every limit back.
# PRODUCT_LIMITS=off
