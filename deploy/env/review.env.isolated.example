# /etc/social-auto/review.env  (owner root, group social-review, mode 640). Names only: fill the values on the server.
# The review service and the poster engine read THIS file and nothing else: it holds no platform credential and no publisher secret,
# so nothing these programs do can reach Instagram, Facebook, LinkedIn or Google.
# A long random secret (at least 32 bytes), made on the server (for example: openssl rand -base64 48) and never sent through chat or committed.
REVIEW_SECRET=
# The folders the poster engine and the review service share.
BRANDS_ROOT=/var/lib/social-auto/brands
# Publishing from the engine stays off for the owner-approval beta; approved posters are downloaded and posted by hand.
SOCIAL_PUBLISHING_ENABLED=false
# The fully AI route's creative director stays off until it has had a live evaluation.
CREATIVE_DIRECTOR_ENABLED=false
# The picture and writing models (the engine only). Spending is capped by the paid-call ledger.
OPENAI_API_KEY=
PAID_LEDGER_FILE=/var/lib/social-auto/ledger/paid-calls.jsonl
