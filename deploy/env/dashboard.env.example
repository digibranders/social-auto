# /etc/social-auto/dashboard.env  (owner root, group social, mode 640). Names only: fill the values on the server.
DASHBOARD_PASSWORD=
SESSION_SECRET=
EDIT_SECRET=
STATUS_SECRET=
INVITE_SECRET=
# The publisher on this same machine
EDIT_URL=http://127.0.0.1:4021
STATUS_URL=http://127.0.0.1:4021/api/status
FACEBOOK_APP_ID=
FACEBOOK_CONFIG_ID=
INSTAGRAM_APP_ID=
# Same switch as in publisher.env. With INSTAGRAM_LOGIN=facebook the Instagram button uses FACEBOOK_APP_ID and this configuration (Meta app, Facebook Login for Business, Configurations).
INSTAGRAM_LOGIN=
INSTAGRAM_CONFIG_ID=
LINKEDIN_CLIENT_ID=
# Company pages (LinkedIn's Community Management API, a second LinkedIn app). While LINKEDIN_PAGES=on the connect link asks for the pages the person administers instead of their own profile.
# LINKEDIN_PAGES=on
# LINKEDIN_PAGES_CLIENT_ID=
GOOGLE_CLIENT_ID=

# The review queue (the poster engine's review service on this server, local address only) and its secret: the same value as REVIEW_SECRET in review.env.
REVIEW_URL=http://127.0.0.1:4012
REVIEW_SECRET=
# Whether the dashboard may create hand-made posts and change a post's caption or picture. OFF unless exactly "true". Setting it to "true" keeps today's
# manual posting and editing working for existing clients; leave it off to switch them off.
SOCIAL_PUBLISHING_ENABLED=false
