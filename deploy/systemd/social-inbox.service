[Unit]
Description=Social Auto inbox check (reads new comments on posts; writes nothing to the networks)
After=social-publisher.service

[Service]
Type=oneshot
User=social
Group=social
EnvironmentFile=/etc/social-auto/publisher.env
ExecStart=/home/social/social-auto/deploy/scripts/call-publisher.sh /api/inbox-collect
TimeoutStartSec=10min
