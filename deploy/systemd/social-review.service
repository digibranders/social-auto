[Unit]
Description=Social Auto review queue (JSON service for the dashboard, local address only)
After=network-online.target

[Service]
User=social
Group=social
WorkingDirectory=/home/social/social-auto/scheduler/engine
EnvironmentFile=/etc/social-auto/review.env
ExecStart=/home/social/.local/node/bin/node src/review-server.ts
Restart=always
RestartSec=3
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/social/social-auto/scheduler/engine/brands

[Install]
WantedBy=multi-user.target
