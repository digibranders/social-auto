[Unit]
Description=Social Auto analytics check (reads numbers from the networks; writes nothing to them)
After=social-publisher.service

[Service]
Type=oneshot
User=social
Group=social
EnvironmentFile=/etc/social-auto/publisher.env
ExecStart=/home/social/social-auto/deploy/scripts/call-publisher.sh /api/analytics-collect
TimeoutStartSec=15min
