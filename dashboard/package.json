{
  "name": "social-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import ./dev/resolver.ts --test lib/*.test.ts shared/*.test.ts web/*.test.ts server/*.test.ts",
    "dev": "npm run build && node --import ./dev/resolver.ts dev/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
